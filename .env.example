# Copy to .env and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=rideshare
POSTGRES_USER=rideshare
POSTGRES_PASSWORD=change-me-strong-password

# --- Security ---------------------------------------------------------------
# Base64 key of >= 32 random bytes. Generate with:  openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48
# Access tokens are short-lived; the browser renews them with the refresh cookie.
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_DAYS=14
# true when the site is served over HTTPS (production); false for http://localhost
REFRESH_COOKIE_SECURE=false

# Only these email domains can register (comma separated; subdomains allowed)
ALLOWED_EMAIL_DOMAINS=iitbbs.ac.in

# Browser origins allowed to call the API directly (not needed behind nginx)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# First admin account, created on startup if it does not exist yet
ADMIN_EMAIL=admin@iitbbs.ac.in
ADMIN_PASSWORD=change-me-admin-password

# --- Behaviour ----------------------------------------------------------------
APP_TIME_ZONE=Asia/Kolkata
MAX_PICKUP_DISTANCE_KM=3.0
MAX_DESTINATION_DISTANCE_KM=5.0
MAX_TIME_DIFFERENCE_MINUTES=60
RIDE_MAX_WAITLIST_SIZE=20

# --- Rate limiting (per minute) -------------------------------------------------
# Login/register are limited per client IP, join/waitlist per user.
# Set RATE_LIMIT_ENABLED=false only for the race demo / load tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_JOIN_PER_MINUTE=30

# Set to "demo" to seed 5 sample students and 4 sample rides (development only)
SPRING_PROFILES_ACTIVE=
